const INITIAL_BADGES = [
  { id: 'start', title: 'Perjalanan Bermula', desc: 'Memulakan Cabaran 90 Hari', icon: '🚀', requirement: () => true },
  { id: 'first_2kg', title: '2kg Pertama Terbakar', desc: 'Penurunan 2kg pertama', icon: '🔥', requirement: (p) => {
    const wifeLost = p.wife.initialWeight - p.wife.currentWeight;
    const husbLost = p.husband.initialWeight - p.husband.currentWeight;
    return wifeLost >= 2 || husbLost >= 2;
  }},
  { id: 'water_master', title: 'Juara Hidrasi', desc: 'Mencapai 500+ Mata Hidrasi', icon: '💧', requirement: (p) => (p.wife.points + p.husband.points) >= 500 },
  { id: 'halfway', title: 'Pahlawan Pertengahan', desc: 'Tiba di Minggu ke-6 Cabaran', icon: '🛡️', requirement: (p, history, week) => week >= 6 },
  { id: 'target_met', title: 'Sasaran Dicapai!', desc: 'Berjaya mencapai sasaran berat pertama', icon: '👑', requirement: (p) => p.wife.currentWeight <= p.wife.firstTarget || p.husband.currentWeight <= p.husband.firstTarget },
  { id: '1000_pts', title: 'Kelab 1,000 Mata', desc: 'Terkumpul 1,000 jumlah mata pasangan', icon: '⭐', requirement: (p) => (p.wife.points + p.husband.points) >= 1000 }
];

// Helper Functions
const calculateBMI = (weight, heightCm) => {
  if (!weight || !heightCm) return 0;
  const heightM = heightCm / 100;
  return (weight / (heightM * heightM)).toFixed(1);
};

const getBMICategory = (bmi) => {
  if (bmi < 18.5) return { label: 'Kurang Berat', color: 'text-blue-500' };
  if (bmi < 24.9) return { label: 'Ideal', color: 'text-emerald-600 font-bold' };
  if (bmi < 29.9) return { label: 'Berlebihan Berat', color: 'text-amber-500' };
  return { label: 'Obesiti', color: 'text-pink-600 font-bold' };
};

export default function App() {
  // --- STATES ---
  const [activeTab, setActiveTab] = useState('dashboard');
  const [profiles, setProfiles] = useState(() => {
    const saved = localStorage.getItem('90day_profiles_v2');
    return saved ? JSON.parse(saved) : INITIAL_PROFILES;
  });

  const [currentWeekNum, setCurrentWeekNum] = useState(1);
  const [selectedDayMealIdx, setSelectedDayMealIdx] = useState(0);
  
  // Weight Log History
  const [weightLogs, setWeightLogs] = useState(() => {
    const saved = localStorage.getItem('90day_weight_logs_v2');
    return saved ? JSON.parse(saved) : [
      { date: new Date().toISOString().split('T')[0], wifeWeight: 115, husbandWeight: 80, note: 'Timbangan Perdana (Hari 1)' }
    ];
  });

  // Daily Habits Log (Water, Meals, Exercise)
  const [dailyHabits, setDailyHabits] = useState(() => {
    const saved = localStorage.getItem('90day_daily_habits_v2');
    const today = new Date().toISOString().split('T')[0];
    return saved ? JSON.parse(saved) : {
      date: today,
      wifeWater: 4,
      husbandWater: 5,
      wifeCalories: 1500,
      husbandCalories: 1750,
      workoutDone: true,
      workoutNotes: 'Brisk walk 25 minit di taman',
      completedMeals: {}
    };
  });

  // Checklist State
  const [checklist, setChecklist] = useState(() => {
    const saved = localStorage.getItem('90day_checklist_v2');
    return saved ? JSON.parse(saved) : {};
  });

  // Reflections State
  const [reflections, setReflections] = useState(() => {
    const saved = localStorage.getItem('90day_reflections_v2');
    return saved ? JSON.parse(saved) : {};
  });

  // Form states for Weight Modal
  const [newLog, setNewLog] = useState({
    date: new Date().toISOString().split('T')[0],
    wifeWeight: profiles.wife.currentWeight,
    husbandWeight: profiles.husband.currentWeight,
    note: ''
  });

  const [showEditTargetModal, setShowEditTargetModal] = useState(false);
  const [editTargetData, setEditTargetData] = useState({
    wifeFirst: profiles.wife.firstTarget,
    wifeFinal: profiles.wife.finalTarget,
    husbandFirst: profiles.husband.firstTarget,
    husbandFinal: profiles.husband.finalTarget
  });

  const [showResetModal, setShowResetModal] = useState(false);

  // --- LOCALSTORAGE PERSISTENCE ---
  useEffect(() => {
    localStorage.setItem('90day_profiles_v2', JSON.stringify(profiles));
  }, [profiles]);

  useEffect(() => {
    localStorage.setItem('90day_weight_logs_v2', JSON.stringify(weightLogs));
  }, [weightLogs]);

  useEffect(() => {
    localStorage.setItem('90day_daily_habits_v2', JSON.stringify(dailyHabits));
  }, [dailyHabits]);

  useEffect(() => {
    localStorage.setItem('90day_checklist_v2', JSON.stringify(checklist));
  }, [checklist]);

  useEffect(() => {
    localStorage.setItem('90day_reflections_v2', JSON.stringify(reflections));
  }, [reflections]);

  // Calculations for Days & Expected Daily Targets
  const dayStats = useMemo(() => {
    const start = new Date(profiles.startDate);
    const today = new Date();
    const diffTime = Math.abs(today - start);
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
    const currentDay = Math.min(Math.max(diffDays, 1), 90);
    const remainingDays = Math.max(90 - currentDay, 0);

    // Pengiraan Berat Patut Turun Hari Ini secara linear (90 hari)
    // Formula: Initial - ( (Initial - FinalTarget) * (currentDay / 90) )
    const wifeTotalTargetDrop = profiles.wife.initialWeight - profiles.wife.firstTarget;
    const husbandTotalTargetDrop = profiles.husband.initialWeight - profiles.husband.firstTarget;

    const wifeExpectedWeightToday = (profiles.wife.initialWeight - (wifeTotalTargetDrop * (currentDay / 90))).toFixed(1);
    const husbandExpectedWeightToday = (profiles.husband.initialWeight - (husbandTotalTargetDrop * (currentDay / 90))).toFixed(1);

    // Dynamic Date display string
    const currentDateStr = today.toLocaleDateString('ms-MY', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });

    return { 
      currentDay, 
      remainingDays, 
      currentDateStr,
      wifeExpectedWeightToday: parseFloat(wifeExpectedWeightToday),
      husbandExpectedWeightToday: parseFloat(husbandExpectedWeightToday)
    };
  }, [profiles.startDate, profiles.wife, profiles.husband]);

  // Recalculate Points based on Checklist
  const updatePoints = (newChecklist) => {
    let wifePts = 0;
    let husbPts = 0;
    Object.keys(newChecklist).forEach(key => {
      if (newChecklist[key]) {
        if (key.endsWith('wife')) wifePts += 10;
        if (key.endsWith('husband')) husbPts += 10;
      }
    });
    setProfiles(prev => ({
      ...prev,
      wife: { ...prev.wife, points: wifePts },
      husband: { ...prev.husband, points: husbPts }
    }));
  };

  const handleTaskToggle = (weekNum, dayIdx, person) => {
    const key = `week-${weekNum}-day-${dayIdx}-${person}`;
    const updated = { ...checklist, [key]: !checklist[key] };
    setChecklist(updated);
    updatePoints(updated);
  };

  const handleMealToggle = (mealType) => {
    const key = `day-${selectedDayMealIdx}-${mealType}`;
    const updatedMeals = {
      ...dailyHabits.completedMeals,
      [key]: !dailyHabits.completedMeals?.[key]
    };
    setDailyHabits({ ...dailyHabits, completedMeals: updatedMeals });
  };

  const handleAddWeightLog = (e) => {
    e.preventDefault();
    const wVal = parseFloat(newLog.wifeWeight);
    const hVal = parseFloat(newLog.husbandWeight);

    if (isNaN(wVal) || isNaN(hVal)) return;

    const updatedLogs = [...weightLogs, { ...newLog, wifeWeight: wVal, husbandWeight: hVal }];
    updatedLogs.sort((a, b) => new Date(a.date) - new Date(b.date));
    setWeightLogs(updatedLogs);

    setProfiles(prev => ({
      ...prev,
      wife: { ...prev.wife, currentWeight: wVal },
      husband: { ...prev.husband, currentWeight: hVal }
    }));

    setNewLog({
      date: new Date().toISOString().split('T')[0],
      wifeWeight: wVal,
      husbandWeight: hVal,
      note: ''
    });
  };

  const handleDeleteWeightLog = (index) => {
    const updated = weightLogs.filter((_, i) => i !== index);
    setWeightLogs(updated);
    if (updated.length > 0) {
      const last = updated[updated.length - 1];
      setProfiles(prev => ({
        ...prev,
        wife: { ...prev.wife, currentWeight: last.wifeWeight },
        husband: { ...prev.husband, currentWeight: last.husbandWeight }
      }));
    }
  };

  const handleSaveTargets = () => {
    setProfiles(prev => ({
      ...prev,
      wife: {
        ...prev.wife,
        firstTarget: parseFloat(editTargetData.wifeFirst),
        finalTarget: parseFloat(editTargetData.wifeFinal)
      },
      husband: {
        ...prev.husband,
        firstTarget: parseFloat(editTargetData.husbandFirst),
        finalTarget: parseFloat(editTargetData.husbandFinal)
      }
    }));
    setShowEditTargetModal(false);
  };

  const handleResetAllData = () => {
    localStorage.clear();
    setProfiles(INITIAL_PROFILES);
    setWeightLogs([{ date: new Date().toISOString().split('T')[0], wifeWeight: 115, husbandWeight: 80, note: 'Timbangan Perdana' }]);
    setChecklist({});
    setReflections({});
    setShowResetModal(false);
    setActiveTab('dashboard');
  };

  const handleExportData = () => {
    const dataObj = { profiles, weightLogs, dailyHabits, checklist, reflections };
    const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(dataObj, null, 2));
    const downloadAnchor = document.createElement('a');
    downloadAnchor.setAttribute("href", dataStr);
    downloadAnchor.setAttribute("download", `90Days_Couple_Challenge_Data_${new Date().toISOString().split('T')[0]}.json`);
    document.body.appendChild(downloadAnchor);
    downloadAnchor.click();
    downloadAnchor.remove();
  };

  // Percentage Calculations
  const calcProgress = (initial, current, target) => {
    const totalToLose = initial - target;
    if (totalToLose <= 0) return 100;
    const currentLost = initial - current;
    const pct = Math.round((currentLost / totalToLose) * 100);
    return Math.min(Math.max(pct, 0), 100);
  };

  const wifeProgress = calcProgress(profiles.wife.initialWeight, profiles.wife.currentWeight, profiles.wife.finalTarget);
  const husbandProgress = calcProgress(profiles.husband.initialWeight, profiles.husband.currentWeight, profiles.husband.finalTarget);
  const combinedPoints = profiles.wife.points + profiles.husband.points;

  const wifeBmi = calculateBMI(profiles.wife.currentWeight, profiles.wife.height);
  const husbandBmi = calculateBMI(profiles.husband.currentWeight, profiles.husband.height);
  const wifeBmiCat = getBMICategory(wifeBmi);
  const husbandBmiCat = getBMICategory(husbandBmi);

  // Status Pencapaian vs Sasaran Hari Ini
  const getWifeStatus = () => {
    const diff = profiles.wife.currentWeight - dayStats.wifeExpectedWeightToday;
    if (diff <= 0) return { text: "Pencapaian Hebat! ✨", bg: "bg-emerald-100 text-emerald-800 border-emerald-300" };
    if (diff <= 0.5) return { text: "On Track 👍", bg: "bg-blue-100 text-blue-800 border-blue-300" };
    return { text: "Terlebih " + diff.toFixed(1) + "kg dari Sasaran", bg: "bg-pink-100 text-pink-800 border-pink-300" };
  };

  const getHusbandStatus = () => {
    const diff = profiles.husband.currentWeight - dayStats.husbandExpectedWeightToday;
    if (diff <= 0) return { text: "Pencapaian Hebat! ✨", bg: "bg-emerald-100 text-emerald-800 border-emerald-300" };
    if (diff <= 0.5) return { text: "On Track 👍", bg: "bg-blue-100 text-blue-800 border-blue-300" };
    return { text: "Terlebih " + diff.toFixed(1) + "kg dari Sasaran", bg: "bg-amber-100 text-amber-800 border-amber-300" };
  };

  return (
    <div className="min-h-screen bg-slate-50 text-slate-800 font-sans pb-20">
      
      {/* HEADER BAR WITH BLUE & PINK GRADIENT ACCENT */}
      <header className="sticky top-0 z-40 bg-gradient-to-r from-blue-700 via-indigo-700 to-pink-600 text-white shadow-lg border-b border-white/10">
        <div className="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
          <div className="flex items-center space-x-3">
            <div className="bg-amber-400 text-slate-900 p-2 rounded-2xl shadow-md">
              <Trophy className="w-6 h-6" />
            </div>
            <div>
              <h1 className="text-lg font-extrabold tracking-tight text-white flex items-center gap-1.5">
                90 DAYS COUPLE CHALLENGE
              </h1>
              <p className="text-xs text-pink-100 font-medium">Stronger Together, Healthier Forever ❤️</p>
            </div>
          </div>

          <div className="hidden sm:flex items-center space-x-2 text-xs bg-white/10 backdrop-blur-md px-3.5 py-1.5 rounded-full border border-white/20">
            <Sparkles className="w-4 h-4 text-amber-300" />
            <span>Hari ke-<b>{dayStats.currentDay}</b> daripada 90 Hari</span>
          </div>
        </div>
      </header>

      {/* MAIN CONTAINER */}
      <main className="max-w-6xl mx-auto px-4 pt-6 pb-12">
        
        {/* TOP METRICS SUMMARY */}
        <section className="mb-6 grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
          <div className="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-3">
            <div className="p-3 bg-amber-50 rounded-xl text-amber-500">
              <Trophy className="w-6 h-6" />
            </div>
            <div>
              <p className="text-xs text-slate-500 font-medium">Mata Pasangan</p>
              <p className="text-xl font-extrabold text-slate-800">{combinedPoints} <span className="text-xs text-amber-600 font-normal">pts</span></p>
            </div>
          </div>

          <div className="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-3">
            <div className="p-3 bg-emerald-50 rounded-xl text-emerald-600">
              <TrendingDown className="w-6 h-6" />
            </div>
            <div>
              <p className="text-xs text-slate-500 font-medium">Jumlah Terbakar</p>
              <p className="text-xl font-extrabold text-emerald-600">
                {((profiles.wife.initialWeight - profiles.wife.currentWeight) + (profiles.husband.initialWeight - profiles.husband.currentWeight)).toFixed(1)} <span className="text-xs font-normal">kg</span>
              </p>
            </div>
          </div>

          <div className="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-3">
            <div className="p-3 bg-blue-50 rounded-xl text-blue-600">
              <Calendar className="w-6 h-6" />
            </div>
            <div>
              <p className="text-xs text-slate-500 font-medium">Hari Berbaki</p>
              <p className="text-xl font-extrabold text-slate-800">{dayStats.remainingDays} <span className="text-xs font-normal">hari</span></p>
            </div>
          </div>

          <div className="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-3">
            <div className="p-3 bg-pink-50 rounded-xl text-pink-600">
              <Activity className="w-6 h-6" />
            </div>
            <div>
              <p className="text-xs text-slate-500 font-medium">Minggu Cabaran</p>
              <p className="text-xl font-extrabold text-slate-800">Minggu {currentWeekNum}</p>
            </div>
          </div>
        </section>

        {/* DAILY DATE & EXPECTED WEIGHT TARGET BAR */}
        <section className="mb-6 bg-gradient-to-r from-blue-600 to-pink-500 text-white rounded-3xl p-5 shadow-md flex flex-col md:flex-row items-center justify-between gap-4">
          <div className="flex items-center space-x-3">
            <div className="p-3 bg-white/20 rounded-2xl backdrop-blur-md">
              <Calendar className="w-6 h-6 text-white" />
            </div>
            <div>
              <span className="text-[11px] font-bold uppercase tracking-wider text-white/80">Tarikh Hari Ini</span>
              <h3 className="text-lg font-extrabold text-white">{dayStats.currentDateStr}</h3>
            </div>
          </div>

          <div className="flex flex-wrap items-center gap-3 w-full md:w-auto">
            {/* Wife Daily Target */}
            <div className="flex-1 md:flex-none bg-white/10 backdrop-blur-md border border-white/20 px-4 py-2.5 rounded-2xl text-center">
              <span className="text-[10px] text-pink-200 font-bold block uppercase">Sasaran Isteri Hari Ini</span>
              <span className="text-base font-extrabold text-white">{dayStats.wifeExpectedWeightToday} kg</span>
            </div>

            {/* Husband Daily Target */}
            <div className="flex-1 md:flex-none bg-white/10 backdrop-blur-md border border-white/20 px-4 py-2.5 rounded-2xl text-center">
              <span className="text-[10px] text-blue-200 font-bold block uppercase">Sasaran Suami Hari Ini</span>
              <span className="text-base font-extrabold text-white">{dayStats.husbandExpectedWeightToday} kg</span>
            </div>
          </div>
        </section>

        {/* NAVIGATION TABS */}
        <div className="flex overflow-x-auto space-x-2 border-b border-slate-200 pb-3 mb-6 scrollbar-none">
          {[
            { id: 'dashboard', label: 'Dashboard Utama', icon: Trophy },
            { id: 'menu', label: 'Menu & Berat Makanan Harian', icon: Utensils },
            { id: 'challenge', label: '12 Minggu Cabaran', icon: Flame },
            { id: 'tracker', label: 'Rekod Berat & Graf', icon: Scale },
            { id: 'daily', label: 'Log Pemakanan & Habit', icon: Apple },
            { id: 'rewards', label: 'Ganjaran & Lencana', icon: Award },
          ].map(tab => {
            const Icon = tab.icon;
            const isActive = activeTab === tab.id;
            return (
              <button
                key={tab.id}
                onClick={() => setActiveTab(tab.id)}
                className={`flex items-center space-x-2 px-4 py-2.5 rounded-xl font-semibold text-sm whitespace-nowrap transition-all ${
                  isActive 
                    ? 'bg-gradient-to-r from-blue-600 to-pink-500 text-white shadow-md' 
                    : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200'
                }`}
              >
                <Icon className={`w-4 h-4 ${isActive ? 'text-amber-300' : ''}`} />
                <span>{tab.label}</span>
              </button>
            );
          })}
        </div>

        {/* ==================== TAB 1: DASHBOARD UTAMA ==================== */}
        {activeTab === 'dashboard' && (
          <div className="space-y-6">
            
            {/* HERO DUAL PROFILE CARDS (PINK & BLUE THEME) */}
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              
              {/* ISTERI CARD - ELEGANT PINK */}
              <div className="bg-white rounded-3xl p-6 border-2 border-pink-100 shadow-sm relative overflow-hidden">
                <div className="absolute top-0 right-0 bg-pink-500 text-white text-xs px-4 py-1.5 rounded-bl-2xl font-bold shadow-sm">
                  ISTERI 🌸
                </div>

                <div className="flex items-center space-x-4 mb-4">
                  <div className="w-14 h-14 bg-pink-100 rounded-2xl flex items-center justify-center text-3xl border border-pink-200 shadow-inner">
                    {profiles.wife.avatar}
                  </div>
                  <div>
                    <h2 className="text-xl font-bold text-slate-800">{profiles.wife.name}</h2>
                    <p className="text-xs text-slate-500">Tinggi: {profiles.wife.height} cm • BMI: <b className="text-slate-700">{wifeBmi}</b> (<span className={wifeBmiCat.color}>{wifeBmiCat.label}</span>)</p>
                  </div>
                </div>

                {/* Target Weight Status Indicator */}
                <div className="mb-4 flex items-center justify-between bg-pink-50 p-2.5 rounded-2xl border border-pink-100">
                  <span className="text-xs text-pink-800 font-semibold">Sasaran Berat Hari Ini: <b>{dayStats.wifeExpectedWeightToday} kg</b></span>
                  <span className={`text-[11px] font-bold px-2.5 py-0.5 rounded-full border ${getWifeStatus().bg}`}>
                    {getWifeStatus().text}
                  </span>
                </div>

                {/* Stat Grid */}
                <div className="grid grid-cols-3 gap-2 bg-slate-50 p-3 rounded-2xl mb-4 border border-slate-100 text-center">
                  <div>
                    <span className="text-[10px] uppercase tracking-wider text-slate-400 font-bold block">Awal</span>
                    <span className="text-lg font-bold text-slate-700">{profiles.wife.initialWeight} <span className="text-xs font-normal">kg</span></span>
                  </div>
                  <div className="border-x border-slate-200">
                    <span className="text-[10px] uppercase tracking-wider text-pink-600 font-bold block">Terkini</span>
                    <span className="text-xl font-extrabold text-pink-600">{profiles.wife.currentWeight} <span className="text-xs font-normal">kg</span></span>
                  </div>
                  <div>
                    <span className="text-[10px] uppercase tracking-wider text-amber-600 font-bold block">Sasaran 1</span>
                    <span className="text-lg font-bold text-slate-700">{profiles.wife.firstTarget} <span className="text-xs font-normal">kg</span></span>
                  </div>
                </div>

                {/* Progress Bar */}
                <div className="space-y-1.5 mb-4">
                  <div className="flex justify-between text-xs font-medium">
                    <span className="text-slate-600">Pencapaian Penurunan</span>
                    <span className="text-pink-600 font-bold">{wifeProgress}%</span>
                  </div>
                  <div className="w-full bg-slate-100 h-3 rounded-full overflow-hidden p-0.5 border border-slate-200">
                    <div 
                      className="bg-gradient-to-r from-pink-400 to-rose-500 h-full rounded-full transition-all duration-500" 
                      style={{ width: `${wifeProgress}%` }}
                    />
                  </div>
                  <div className="flex justify-between text-[11px] text-slate-400 pt-0.5">
                    <span>Turun: <b>{(profiles.wife.initialWeight - profiles.wife.currentWeight).toFixed(1)} kg</b></span>
                    <span>Sasaran Akhir: <b>{profiles.wife.finalTarget} kg</b></span>
                  </div>
                </div>

                <div className="flex items-center justify-between text-xs pt-3 border-t border-slate-100">
                  <span className="text-slate-500">Mata Terkumpul:</span>
                  <span className="px-3 py-1 bg-pink-100 text-pink-800 font-bold rounded-full border border-pink-200">
                    ⭐ {profiles.wife.points} Pts
                  </span>
                </div>
              </div>

              {/* SUAMI CARD - VIBRANT BLUE */}
              <div className="bg-white rounded-3xl p-6 border-2 border-blue-100 shadow-sm relative overflow-hidden">
                <div className="absolute top-0 right-0 bg-blue-600 text-white text-xs px-4 py-1.5 rounded-bl-2xl font-bold shadow-sm">
                  SUAMI 🧢
                </div>

                <div className="flex items-center space-x-4 mb-4">
                  <div className="w-14 h-14 bg-blue-100 rounded-2xl flex items-center justify-center text-3xl border border-blue-200 shadow-inner">
                    {profiles.husband.avatar}
                  </div>
                  <div>
                    <h2 className="text-xl font-bold text-slate-800">{profiles.husband.name}</h2>
                    <p className="text-xs text-slate-500">Tinggi: {profiles.husband.height} cm • BMI: <b className="text-slate-700">{husbandBmi}</b> (<span className={husbandBmiCat.color}>{husbandBmiCat.label}</span>)</p>
                  </div>
                </div>

                {/* Target Weight Status Indicator */}
                <div className="mb-4 flex items-center justify-between bg-blue-50 p-2.5 rounded-2xl border border-blue-100">
                  <span className="text-xs text-blue-800 font-semibold">Sasaran Berat Hari Ini: <b>{dayStats.husbandExpectedWeightToday} kg</b></span>
                  <span className={`text-[11px] font-bold px-2.5 py-0.5 rounded-full border ${getHusbandStatus().bg}`}>
                    {getHusbandStatus().text}
                  </span>
                </div>

                {/* Stat Grid */}
                <div className="grid grid-cols-3 gap-2 bg-slate-50 p-3 rounded-2xl mb-4 border border-slate-100 text-center">
                  <div>
                    <span className="text-[10px] uppercase tracking-wider text-slate-400 font-bold block">Awal</span>
                    <span className="text-lg font-bold text-slate-700">{profiles.husband.initialWeight} <span className="text-xs font-normal">kg</span></span>
                  </div>
                  <div className="border-x border-slate-200">
                    <span className="text-[10px] uppercase tracking-wider text-blue-600 font-bold block">Terkini</span>
                    <span className="text-xl font-extrabold text-blue-600">{profiles.husband.currentWeight} <span className="text-xs font-normal">kg</span></span>
                  </div>
                  <div>
                    <span className="text-[10px] uppercase tracking-wider text-amber-600 font-bold block">Sasaran 1</span>
                    <span className="text-lg font-bold text-slate-700">{profiles.husband.firstTarget} <span className="text-xs font-normal">kg</span></span>
                  </div>
                </div>

                {/* Progress Bar */}
                <div className="space-y-1.5 mb-4">
                  <div className="flex justify-between text-xs font-medium">
                    <span className="text-slate-600">Pencapaian Penurunan</span>
                    <span className="text-blue-600 font-bold">{husbandProgress}%</span>
                  </div>
                  <div className="w-full bg-slate-100 h-3 rounded-full overflow-hidden p-0.5 border border-slate-200">
                    <div 
                      className="bg-gradient-to-r from-blue-400 to-indigo-600 h-full rounded-full transition-all duration-500" 
                      style={{ width: `${husbandProgress}%` }}
                    />
                  </div>
                  <div className="flex justify-between text-[11px] text-slate-400 pt-0.5">
                    <span>Turun: <b>{(profiles.husband.initialWeight - profiles.husband.currentWeight).toFixed(1)} kg</b></span>
                    <span>Sasaran Akhir: <b>{profiles.husband.finalTarget} kg</b></span>
                  </div>
                </div>

                <div className="flex items-center justify-between text-xs pt-3 border-t border-slate-100">
                  <span className="text-slate-500">Mata Terkumpul:</span>
                  <span className="px-3 py-1 bg-blue-100 text-blue-800 font-bold rounded-full border border-blue-200">
                    ⭐ {profiles.husband.points} Pts
                  </span>
                </div>
              </div>

            </div>

            {/* QUICK ACTIONS & TARGET SETTINGS */}
            <div className="flex flex-wrap items-center justify-between gap-3 bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
              <div className="text-xs text-slate-600 flex items-center space-x-2">
                <Sparkles className="w-4 h-4 text-amber-500" />
                <span><b>Tip Perjalanan:</b> Konsistensi kecil setiap hari membawa perubahan besar dalam 90 hari!</span>
              </div>
              <button
                onClick={() => setShowEditTargetModal(true)}
                className="px-3.5 py-2 bg-slate-100 border border-slate-300 text-slate-700 text-xs font-semibold rounded-xl hover:bg-slate-200 shadow-sm flex items-center space-x-1.5"
              >
                <Edit3 className="w-3.5 h-3.5 text-slate-500" />
                <span>Selasar Sasaran Berat</span>
              </button>
            </div>

            {/* CURRENT WEEK PREVIEW CARD */}
            <div className="bg-gradient-to-r from-blue-700 to-indigo-800 text-white rounded-3xl p-6 shadow-md relative overflow-hidden">
              <div className="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
                <div>
                  <span className="px-3 py-1 bg-pink-500 text-white font-bold text-xs rounded-full uppercase tracking-wider inline-block mb-2 shadow">
                    Cabaran Minggu Semasa ({currentWeekNum}/12)
                  </span>
                  <h3 className="text-2xl font-bold">{CHALLENGE_WEEKS[currentWeekNum - 1].title}</h3>
                  <p className="text-sm text-blue-100 mt-1">{CHALLENGE_WEEKS[currentWeekNum - 1].objective}</p>
                </div>
                <button
                  onClick={() => setActiveTab('challenge')}
                  className="px-5 py-2.5 bg-white text-blue-800 font-bold text-xs rounded-xl shadow hover:bg-slate-100 flex items-center justify-center space-x-1 self-start md:self-auto"
                >
                  <span>Buka Checklist Minggu Ini</span>
                  <ChevronRight className="w-4 h-4" />
                </button>
              </div>

              <div className="bg-white/10 backdrop-blur-md p-4 rounded-2xl border border-white/15 text-xs text-blue-50 flex items-start space-x-3">
                <Sparkles className="w-5 h-5 text-amber-300 flex-shrink-0 mt-0.5" />
                <div>
                  <b className="text-white block mb-0.5">Tip Kebijaksanaan Pasangan:</b>
                  {CHALLENGE_WEEKS[currentWeekNum - 1].tip}
                </div>
              </div>
            </div>

          </div>
        )}

        {/* ==================== TAB 2: MENU & BERAT MAKANAN HARIAN ==================== */}
        {activeTab === 'menu' && (
          <div className="space-y-6">
            
            {/* DAY SELECTOR */}
            <div className="flex items-center space-x-2 overflow-x-auto pb-2 scrollbar-none">
              {DAILY_MEAL_PLANS.map((plan, idx) => {
                const isActive = idx === selectedDayMealIdx;
                return (
                  <button
                    key={idx}
                    onClick={() => setSelectedDayMealIdx(idx)}
                    className={`px-4 py-2.5 rounded-xl text-xs font-bold whitespace-nowrap transition-all border ${
                      isActive 
                        ? 'bg-gradient-to-r from-blue-600 to-pink-500 text-white border-transparent shadow' 
                        : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-100'
                    }`}
                  >
                    {plan.dayName}
                  </button>
                );
              })}
            </div>

            {/* SELECTED DAY MEAL DETAILS */}
            {(() => {
              const currentPlan = DAILY_MEAL_PLANS[selectedDayMealIdx];
              const meals = [
                { type: 'breakfast', name: 'Sarapan Pagi 🌅', data: currentPlan.breakfast },
                { type: 'lunch', name: 'Makan Tengah Hari ☀️', data: currentPlan.lunch },
                { type: 'dinner', name: 'Makan Malam 🌙', data: currentPlan.dinner },
                { type: 'snack', name: 'Snek Sihat 🍎', data: currentPlan.snack },
              ];

              return (
                <div className="space-y-6">
                  
                  {/* Header info */}
                  <div className="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                    <div>
                      <span className="text-xs font-bold text-pink-600 uppercase tracking-wider">Menu Pemakanan Hari {currentPlan.dayName}</span>
                      <h2 className="text-2xl font-extrabold text-slate-800">{currentPlan.title}</h2>
                      <p className="text-xs text-slate-500 mt-1">Nisbah sukatan gram dikira khas mengikut sasaran berat Isteri (~1500 kcal) & Suami (~1750 kcal).</p>
                    </div>
                  </div>

                  {/* Meals Grid */}
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {meals.map((m) => {
                      const isCompleted = !!dailyHabits.completedMeals?.[`day-${selectedDayMealIdx}-${m.type}`];

                      return (
                        <div key={m.type} className={`bg-white rounded-3xl p-6 border transition-all shadow-sm space-y-4 ${
                          isCompleted ? 'border-emerald-300 bg-emerald-50/20' : 'border-slate-200'
                        }`}>
                          <div className="flex items-center justify-between border-b border-slate-100 pb-3">
                            <h3 className="font-bold text-base text-slate-800 flex items-center gap-2">
                              <span>{m.name}</span>
                            </h3>
                            <button
                              onClick={() => handleMealToggle(m.type)}
                              className={`flex items-center space-x-1.5 px-3 py-1.5 rounded-xl text-xs font-bold transition-all ${
                                isCompleted 
                                  ? 'bg-emerald-600 text-white' 
                                  : 'bg-slate-100 text-slate-500 hover:bg-slate-200'
                              }`}
                            >
                              {isCompleted ? <Check className="w-3.5 h-3.5" /> : <Circle className="w-3.5 h-3.5" />}
                              <span>{isCompleted ? 'Selesai' : 'Tanda Selesai'}</span>
                            </button>
                          </div>

                          {/* Menu Item Name */}
                          <div className="bg-slate-50 p-3 rounded-2xl border border-slate-100 text-xs font-bold text-slate-700">
                            🥗 Menu: {m.data.menu}
                          </div>

                          {/* Portion Weights Comparison */}
                          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
                            
                            {/* Wife Portion - Pink */}
                            <div className="bg-pink-50/70 p-3.5 rounded-2xl border border-pink-100 space-y-1">
                              <span className="text-[11px] font-bold text-pink-700 flex items-center gap-1">
                                <span>👩‍🍳</span> Sukatan Isteri:
                              </span>
                              <p className="text-xs text-slate-700 leading-relaxed font-medium">
                                {m.data.wifePortion}
                              </p>
                            </div>

                            {/* Husband Portion - Blue */}
                            <div className="bg-blue-50/70 p-3.5 rounded-2xl border border-blue-100 space-y-1">
                              <span className="text-[11px] font-bold text-blue-700 flex items-center gap-1">
                                <span>👨‍💻</span> Sukatan Suami:
                              </span>
                              <p className="text-xs text-slate-700 leading-relaxed font-medium">
                                {m.data.husbandPortion}
                              </p>
                            </div>

                          </div>
                        </div>
                      );
                    })}
                  </div>

                </div>
              );
            })()}

          </div>
        )}

        {/* ==================== TAB 3: 12 MINGGU CABARAN ==================== */}
        {activeTab === 'challenge' && (
          <div className="space-y-6">
            
            {/* WEEK SELECTOR */}
            <div className="flex items-center space-x-2 overflow-x-auto pb-2 scrollbar-none">
              {CHALLENGE_WEEKS.map((w) => {
                const isActive = w.week === currentWeekNum;
                return (
                  <button
                    key={w.week}
                    onClick={() => setCurrentWeekNum(w.week)}
                    className={`px-4 py-2 rounded-xl text-xs font-bold whitespace-nowrap transition-all border ${
                      isActive 
                        ? 'bg-gradient-to-r from-blue-600 to-pink-500 text-white border-transparent shadow scale-105' 
                        : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-100'
                    }`}
                  >
                    Minggu {w.week}
                  </button>
                );
              })}
            </div>

            {/* SELECTED WEEK MODULE DETAIL */}
            {(() => {
              const weekData = CHALLENGE_WEEKS[currentWeekNum - 1];
              const days = ["Isnin", "Selasa", "Rabu", "Khamis", "Jumaat", "Sabtu", "Ahad"];

              return (
                <div className="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-6">
                  
                  {/* Module Header */}
                  <div className="border-b border-slate-100 pb-4">
                    <div className="flex items-center justify-between mb-2">
                      <span className="text-xs font-bold text-pink-600 uppercase tracking-wider">Modul {weekData.week} daripada 12</span>
                      <span className="text-xs px-3 py-1 bg-amber-50 text-amber-800 font-bold rounded-full border border-amber-200">
                        +10 Mata setiap tugasan
                      </span>
                    </div>
                    <h2 className="text-2xl font-extrabold text-slate-800">{weekData.title}</h2>
                    <p className="text-sm text-slate-600 mt-1"><b>Objektif:</b> {weekData.objective}</p>
                    <p className="text-xs text-slate-500 mt-0.5">{weekData.description}</p>
                  </div>

                  {/* Daily Interactive Checklist */}
                  <div className="space-y-4">
                    <h3 className="text-base font-bold text-slate-800 flex items-center gap-2">
                      <CheckCircle2 className="w-5 h-5 text-blue-600" />
                      <span>Checklist Tugasan Harian (Isnin - Ahad)</span>
                    </h3>

                    <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                      {weekData.dailyTasks.map((task, idx) => {
                        const wifeKey = `week-${weekData.week}-day-${idx}-wife`;
                        const husbKey = `week-${weekData.week}-day-${idx}-husband`;
                        const isWifeChecked = !!checklist[wifeKey];
                        const isHusbChecked = !!checklist[husbKey];

                        return (
                          <div key={idx} className="bg-slate-50 p-4 rounded-2xl border border-slate-200 flex flex-col justify-between space-y-3">
                            <div className="flex items-start justify-between space-x-2">
                              <span className="px-2 py-0.5 bg-slate-200 text-slate-700 text-[10px] font-bold rounded uppercase">
                                {days[idx]}
                              </span>
                              <span className="text-xs text-slate-700 font-medium flex-1 text-right">{task}</span>
                            </div>

                            <div className="flex items-center justify-between pt-2 border-t border-slate-200/60">
                              {/* Wife Toggle - Pink Theme */}
                              <button
                                onClick={() => handleTaskToggle(weekData.week, idx, 'wife')}
                                className={`flex items-center space-x-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold transition-all ${
                                  isWifeChecked 
                                    ? 'bg-pink-500 text-white shadow-sm' 
                                    : 'bg-white text-slate-500 border border-slate-200 hover:bg-pink-50'
                                }`}
                              >
                                {isWifeChecked ? <Check className="w-3.5 h-3.5" /> : <Circle className="w-3.5 h-3.5" />}
                                <span>Isteri</span>
                              </button>

                              {/* Husband Toggle - Blue Theme */}
                              <button
                                onClick={() => handleTaskToggle(weekData.week, idx, 'husband')}
                                className={`flex items-center space-x-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold transition-all ${
                                  isHusbChecked 
                                    ? 'bg-blue-600 text-white shadow-sm' 
                                    : 'bg-white text-slate-500 border border-slate-200 hover:bg-blue-50'
                                }`}
                              >
                                {isHusbChecked ? <Check className="w-3.5 h-3.5" /> : <Circle className="w-3.5 h-3.5" />}
                                <span>Suami</span>
                              </button>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>

                  {/* Weekly Tip Card */}
                  <div className="bg-amber-50 p-4 rounded-2xl border border-amber-200 text-xs text-amber-900 flex items-start space-x-3">
                    <Sparkles className="w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5" />
                    <div>
                      <b className="block font-bold text-amber-950 mb-0.5">Tip Mingguan Pasangan:</b>
                      {weekData.tip}
                    </div>
                  </div>

                  {/* Weekly Reflection Input */}
                  <div className="space-y-2 pt-2">
                    <label className="block text-xs font-bold text-slate-700">
                      📝 Catatan Refleksi Mingguan (Isteri & Suami):
                    </label>
                    <textarea
                      rows={3}
                      value={reflections[`week-${weekData.week}`] || ''}
                      onChange={(e) => setReflections({ ...reflections, [`week-${weekData.week}`]: e.target.value })}
                      placeholder="Tulis perasaan, cabaran, atau pencapaian manis korang berdua minggu ini..."
                      className="w-full p-3 text-xs bg-slate-50 border border-slate-300 rounded-2xl focus:ring-2 focus:ring-pink-500 focus:outline-none"
                    />
                  </div>

                </div>
              );
            })()}

          </div>
        )}

        {/* ==================== TAB 4: REKOD BERAT & GRAF ==================== */}
        {activeTab === 'tracker' && (
          <div className="space-y-6">
            
            {/* ADD WEIGHT LOG FORM */}
            <div className="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm">
              <h3 className="text-lg font-bold text-slate-800 mb-4 flex items-center space-x-2">
                <Plus className="w-5 h-5 text-pink-500" />
                <span>Tambah Rekod Timbangan Baru</span>
              </h3>

              <form onSubmit={handleAddWeightLog} className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                <div>
                  <label className="block text-xs font-medium text-slate-600 mb-1">Tarikh Rekod</label>
                  <input
                    type="date"
                    required
                    value={newLog.date}
                    onChange={(e) => setNewLog({ ...newLog, date: e.target.value })}
                    className="w-full px-3 py-2 text-xs border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none"
                  />
                </div>

                <div>
                  <label className="block text-xs font-medium text-pink-600 font-bold mb-1">Berat Isteri (kg)</label>
                  <input
                    type="number"
                    step="0.1"
                    required
                    value={newLog.wifeWeight}
                    onChange={(e) => setNewLog({ ...newLog, wifeWeight: e.target.value })}
                    className="w-full px-3 py-2 text-xs border border-pink-300 rounded-xl focus:ring-2 focus:ring-pink-500 outline-none"
                  />
                </div>

                <div>
                  <label className="block text-xs font-medium text-blue-600 font-bold mb-1">Berat Suami (kg)</label>
                  <input
                    type="number"
                    step="0.1"
                    required
                    value={newLog.husbandWeight}
                    onChange={(e) => setNewLog({ ...newLog, husbandWeight: e.target.value })}
                    className="w-full px-3 py-2 text-xs border border-blue-300 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none"
                  />
                </div>

                <div>
                  <label className="block text-xs font-medium text-slate-600 mb-1">Nota Singkat</label>
                  <input
                    type="text"
                    placeholder="Contoh: Selepas senaman"
                    value={newLog.note}
                    onChange={(e) => setNewLog({ ...newLog, note: e.target.value })}
                    className="w-full px-3 py-2 text-xs border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none"
                  />
                </div>

                <div className="sm:col-span-2 md:col-span-4 flex justify-end">
                  <button
                    type="submit"
                    className="px-6 py-2.5 bg-gradient-to-r from-blue-600 to-pink-500 text-white font-bold text-xs rounded-xl shadow hover:opacity-95 transition-all flex items-center space-x-2"
                  >
                    <Plus className="w-4 h-4" />
                    <span>Simpan Rekod Berat</span>
                  </button>
                </div>
              </form>
            </div>

            {/* WEIGHT PROGRESS CHART */}
            <div className="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm">
              <div className="flex flex-col sm:flex-row sm:items-center justify-between mb-4 gap-2">
                <div>
                  <h3 className="text-lg font-bold text-slate-800">Graf Trend Penurunan Berat Badan</h3>
                  <p className="text-xs text-slate-500">Perbandingan pergerakan berat Isteri (Pink) vs Suami (Biru)</p>
                </div>
                <div className="flex items-center space-x-3 text-xs">
                  <span className="flex items-center gap-1 font-semibold text-pink-500">
                    <span className="w-3 h-3 rounded-full bg-pink-500 inline-block"></span> Isteri
                  </span>
                  <span className="flex items-center gap-1 font-semibold text-blue-600">
                    <span className="w-3 h-3 rounded-full bg-blue-600 inline-block"></span> Suami
                  </span>
                </div>
              </div>

              <div className="h-72 w-full pt-4">
                <ResponsiveContainer width="100%" height="100%">
                  <LineChart data={weightLogs} margin={{ top: 5, right: 20, left: -20, bottom: 5 }}>
                    <CartesianGrid strokeDasharray="3 3" stroke="#f1f5f9" />
                    <XAxis dataKey="date" tick={{ fontSize: 11, fill: '#64748b' }} />
                    <YAxis domain={['auto', 'auto']} tick={{ fontSize: 11, fill: '#64748b' }} />
                    <Tooltip 
                      contentStyle={{ backgroundColor: '#fff', borderRadius: '12px', border: '1px solid #e2e8f0', fontSize: '12px' }}
                    />
                    <Legend wrapperStyle={{ paddingTop: '10px', fontSize: '12px' }} />
                    <Line type="monotone" dataKey="wifeWeight" name="Isteri (kg)" stroke="#ec4899" strokeWidth={3} dot={{ r: 4 }} activeDot={{ r: 6 }} />
                    <Line type="monotone" dataKey="husbandWeight" name="Suami (kg)" stroke="#2563eb" strokeWidth={3} dot={{ r: 4 }} activeDot={{ r: 6 }} />
                  </LineChart>
                </ResponsiveContainer>
              </div>
            </div>

            {/* WEIGHT LOG TABLE */}
            <div className="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm overflow-hidden">
              <h3 className="text-lg font-bold text-slate-800 mb-4">Sejarah Rekod Timbangan</h3>

              <div className="overflow-x-auto">
                <table className="w-full text-left text-xs border-collapse">
                  <thead>
                    <tr className="bg-slate-50 border-b border-slate-200 text-slate-500 font-bold uppercase tracking-wider">
                      <th className="p-3">Tarikh</th>
                      <th className="p-3">Berat Isteri</th>
                      <th className="p-3">Berat Suami</th>
                      <th className="p-3">Nota</th>
                      <th className="p-3 text-center">Tindakan</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-100">
                    {weightLogs.map((log, idx) => (
                      <tr key={idx} className="hover:bg-slate-50/60">
                        <td className="p-3 font-semibold text-slate-700">{log.date}</td>
                        <td className="p-3 text-pink-600 font-bold">{log.wifeWeight} kg</td>
                        <td className="p-3 text-blue-600 font-bold">{log.husbandWeight} kg</td>
                        <td className="p-3 text-slate-500">{log.note || '-'}</td>
                        <td className="p-3 text-center">
                          <button
                            onClick={() => handleDeleteWeightLog(idx)}
                            className="p-1 text-slate-400 hover:text-rose-500 rounded-lg hover:bg-rose-50 transition-all"
                            title="Padam Rekod"
                          >
                            <Trash2 className="w-4 h-4" />
                          </button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

          </div>
        )}

        {/* ==================== TAB 5: LOG PEMAKANAN & HABIT ==================== */}
        {activeTab === 'daily' && (
          <div className="space-y-6">
            
            {/* WATER TRACKER SECTION */}
            <div className="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm">
              <h3 className="text-lg font-bold text-slate-800 mb-1 flex items-center space-x-2">
                <Droplet className="w-5 h-5 text-blue-500" />
                <span>Water Intake Tracker (Gelas Air Harian)</span>
              </h3>
              <p className="text-xs text-slate-500 mb-6">Sasaran: 8 - 10 Gelas (2.5L - 3.5L) sehari setiap orang</p>

              <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                
                {/* Wife Water - Pink Theme */}
                <div className="bg-pink-50/50 p-5 rounded-2xl border border-pink-100 space-y-3">
                  <div className="flex justify-between items-center">
                    <span className="font-bold text-sm text-slate-800 flex items-center gap-1.5">
                      <span>👩‍🍳</span> Isteri
                    </span>
                    <span className="text-xs font-bold text-pink-600 bg-white px-2.5 py-1 rounded-full border border-pink-200">
                      {dailyHabits.wifeWater} Gelas ({(dailyHabits.wifeWater * 0.35).toFixed(1)}L)
                    </span>
                  </div>

                  <div className="flex items-center space-x-2 justify-center py-2">
                    <button
                      onClick={() => setDailyHabits({ ...dailyHabits, wifeWater: Math.max(0, dailyHabits.wifeWater - 1) })}
                      className="w-8 h-8 rounded-full bg-white border border-slate-300 flex items-center justify-center font-bold text-slate-600 hover:bg-slate-100"
                    >
                      -
                    </button>
                    <div className="flex space-x-1 overflow-x-auto max-w-[200px] px-1">
                      {Array.from({ length: Math.min(10, dailyHabits.wifeWater) }).map((_, i) => (
                        <Droplet key={i} className="w-5 h-5 text-pink-500 fill-pink-400 flex-shrink-0" />
                      ))}
                    </div>
                    <button
                      onClick={() => setDailyHabits({ ...dailyHabits, wifeWater: dailyHabits.wifeWater + 1 })}
                      className="w-8 h-8 rounded-full bg-pink-500 text-white flex items-center justify-center font-bold hover:bg-pink-600"
                    >
                      +
                    </button>
                  </div>
                </div>

                {/* Husband Water - Blue Theme */}
                <div className="bg-blue-50/50 p-5 rounded-2xl border border-blue-100 space-y-3">
                  <div className="flex justify-between items-center">
                    <span className="font-bold text-sm text-slate-800 flex items-center gap-1.5">
                      <span>👨‍💻</span> Suami
                    </span>
                    <span className="text-xs font-bold text-blue-600 bg-white px-2.5 py-1 rounded-full border border-blue-200">
                      {dailyHabits.husbandWater} Gelas ({(dailyHabits.husbandWater * 0.35).toFixed(1)}L)
                    </span>
                  </div>

                  <div className="flex items-center space-x-2 justify-center py-2">
                    <button
                      onClick={() => setDailyHabits({ ...dailyHabits, husbandWater: Math.max(0, dailyHabits.husbandWater - 1) })}
                      className="w-8 h-8 rounded-full bg-white border border-slate-300 flex items-center justify-center font-bold text-slate-600 hover:bg-slate-100"
                    >
                      -
                    </button>
                    <div className="flex space-x-1 overflow-x-auto max-w-[200px] px-1">
                      {Array.from({ length: Math.min(10, dailyHabits.husbandWater) }).map((_, i) => (
                        <Droplet key={i} className="w-5 h-5 text-blue-500 fill-blue-400 flex-shrink-0" />
                      ))}
                    </div>
                    <button
                      onClick={() => setDailyHabits({ ...dailyHabits, husbandWater: dailyHabits.husbandWater + 1 })}
                      className="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold hover:bg-blue-700"
                    >
                      +
                    </button>
                  </div>
                </div>

              </div>
            </div>

            {/* CALORIE & MEAL SUMMARY */}
            <div className="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-4">
              <h3 className="text-lg font-bold text-slate-800 flex items-center space-x-2">
                <Apple className="w-5 h-5 text-emerald-600" />
                <span>Anggaran Kalori Harian</span>
              </h3>

              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div className="bg-pink-50/40 p-4 rounded-2xl border border-pink-100">
                  <label className="block text-xs font-semibold text-pink-700 mb-1">Anggaran Kalori Isteri (kcal)</label>
                  <input
                    type="number"
                    value={dailyHabits.wifeCalories}
                    onChange={(e) => setDailyHabits({ ...dailyHabits, wifeCalories: parseInt(e.target.value) || 0 })}
                    className="w-full p-2.5 text-sm bg-white border border-pink-200 rounded-xl focus:ring-2 focus:ring-pink-500 outline-none"
                  />
                </div>

                <div className="bg-blue-50/40 p-4 rounded-2xl border border-blue-100">
                  <label className="block text-xs font-semibold text-blue-700 mb-1">Anggaran Kalori Suami (kcal)</label>
                  <input
                    type="number"
                    value={dailyHabits.husbandCalories}
                    onChange={(e) => setDailyHabits({ ...dailyHabits, husbandCalories: parseInt(e.target.value) || 0 })}
                    className="w-full p-2.5 text-sm bg-white border border-blue-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none"
                  />
                </div>
              </div>
            </div>

            {/* WORKOUT LOG */}
            <div className="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-4">
              <h3 className="text-lg font-bold text-slate-800 flex items-center space-x-2">
                <Dumbbell className="w-5 h-5 text-amber-500" />
                <span>Log Senaman Bersama (Couple Workout)</span>
              </h3>

              <div className="space-y-3">
                <label className="block text-xs font-medium text-slate-600">Aktiviti Senaman / Sukan Hari Ini:</label>
                <textarea
                  rows={3}
                  value={dailyHabits.workoutNotes}
                  onChange={(e) => setDailyHabits({ ...dailyHabits, workoutNotes: e.target.value })}
                  placeholder="Contoh: Berjalan santai 30 minit di tasik + Stretching 10 minit bersama..."
                  className="w-full p-3 text-xs bg-slate-50 border border-slate-300 rounded-2xl focus:ring-2 focus:ring-blue-500 outline-none"
                />
              </div>
            </div>

          </div>
        )}

        {/* ==================== TAB 6: GANJARAN & LENCANA ==================== */}
        {activeTab === 'rewards' && (
          <div className="space-y-6">
            
            {/* BADGES GRID */}
            <div className="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm">
              <div className="mb-6">
                <h3 className="text-lg font-bold text-slate-800">Lencana Pencapaian Pasangan</h3>
                <p className="text-xs text-slate-500">Lencana akan dibuka secara automatik mengikut kemajuan dan pencapaian korang!</p>
              </div>

              <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                {INITIAL_BADGES.map((badge) => {
                  const isUnlocked = badge.requirement(profiles, weightLogs, currentWeekNum);

                  return (
                    <div 
                      key={badge.id} 
                      className={`p-4 rounded-2xl border transition-all flex items-start space-x-3 ${
                        isUnlocked 
                          ? 'bg-gradient-to-r from-amber-50 to-pink-50 border-amber-300 shadow-sm' 
                          : 'bg-slate-50 border-slate-200 opacity-50 grayscale'
                      }`}
                    >
                      <div className="text-3xl p-2 bg-white rounded-xl shadow-sm border border-slate-100 flex-shrink-0">
                        {badge.icon}
                      </div>
                      <div>
                        <div className="flex items-center space-x-1.5">
                          <h4 className="font-bold text-sm text-slate-800">{badge.title}</h4>
                          {isUnlocked && <CheckCircle2 className="w-4 h-4 text-emerald-600 flex-shrink-0" />}
                        </div>
                        <p className="text-xs text-slate-500 mt-0.5">{badge.desc}</p>
                        <span className={`inline-block mt-2 text-[10px] font-bold px-2 py-0.5 rounded-full ${
                          isUnlocked ? 'bg-amber-200 text-amber-900' : 'bg-slate-200 text-slate-600'
                        }`}>
                          {isUnlocked ? 'Telah Terbuka 🎉' : 'Terkunci 🔒'}
                        </span>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>

            {/* DATA MANAGEMENT SECTION */}
            <div className="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-4">
              <h3 className="text-lg font-bold text-slate-800">Pengurusan Data & Cadangan Back-up</h3>
              <p className="text-xs text-slate-500">Semua rekod anda disimpan dengan selamat dalam peranti anda melalui LocalStorage.</p>

              <div className="flex flex-wrap gap-3 pt-2">
                <button
                  onClick={handleExportData}
                  className="px-4 py-2 bg-gradient-to-r from-blue-600 to-pink-500 text-white font-bold text-xs rounded-xl shadow hover:opacity-95 flex items-center space-x-2"
                >
                  <Download className="w-4 h-4" />
                  <span>Muat Turun Data (Export JSON)</span>
                </button>

                <button
                  onClick={() => setShowResetModal(true)}
                  className="px-4 py-2 bg-rose-50 text-rose-700 border border-rose-200 font-bold text-xs rounded-xl hover:bg-rose-100 flex items-center space-x-2"
                >
                  <RefreshCw className="w-4 h-4" />
                  <span>Reset Semua Data (Mula Semula)</span>
                </button>
              </div>
            </div>

          </div>
        )}

      </main>

      {/* ==================== EDIT TARGET MODAL ==================== */}
      {showEditTargetModal && (
        <div className="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-white rounded-3xl max-w-md w-full p-6 shadow-xl border border-slate-200 space-y-4 animate-in fade-in zoom-in-95">
            <h3 className="text-lg font-bold text-slate-800">Selasar Sasaran Berat Badan</h3>
            
            <div className="space-y-3">
              <div className="p-3 bg-pink-50 rounded-2xl border border-pink-100 space-y-2">
                <span className="text-xs font-bold text-pink-700 block">ISTERI 🌸</span>
                <div className="grid grid-cols-2 gap-2">
                  <div>
                    <label className="text-[10px] text-slate-500 font-medium">Sasaran 1 (kg)</label>
                    <input 
                      type="number" 
                      value={editTargetData.wifeFirst}
                      onChange={(e) => setEditTargetData({ ...editTargetData, wifeFirst: e.target.value })}
                      className="w-full p-2 text-xs border rounded-xl"
                    />
                  </div>
                  <div>
                    <label className="text-[10px] text-slate-500 font-medium">Target Akhir 90 Hari (kg)</label>
                    <input 
                      type="number" 
                      value={editTargetData.wifeFinal}
                      onChange={(e) => setEditTargetData({ ...editTargetData, wifeFinal: e.target.value })}
                      className="w-full p-2 text-xs border rounded-xl"
                    />
                  </div>
                </div>
              </div>

              <div className="p-3 bg-blue-50 rounded-2xl border border-blue-100 space-y-2">
                <span className="text-xs font-bold text-blue-700 block">SUAMI 🧢</span>
                <div className="grid grid-cols-2 gap-2">
                  <div>
                    <label className="text-[10px] text-slate-500 font-medium">Sasaran 1 (kg)</label>
                    <input 
                      type="number" 
                      value={editTargetData.husbandFirst}
                      onChange={(e) => setEditTargetData({ ...editTargetData, husbandFirst: e.target.value })}
                      className="w-full p-2 text-xs border rounded-xl"
                    />
                  </div>
                  <div>
                    <label className="text-[10px] text-slate-500 font-medium">Target Akhir 90 Hari (kg)</label>
                    <input 
                      type="number" 
                      value={editTargetData.husbandFinal}
                      onChange={(e) => setEditTargetData({ ...editTargetData, husbandFinal: e.target.value })}
                      className="w-full p-2 text-xs border rounded-xl"
                    />
                  </div>
                </div>
              </div>
            </div>

            <div className="flex justify-end space-x-2 pt-2">
              <button
                onClick={() => setShowEditTargetModal(false)}
                className="px-4 py-2 bg-slate-100 text-slate-600 font-bold text-xs rounded-xl hover:bg-slate-200"
              >
                Batal
              </button>
              <button
                onClick={handleSaveTargets}
                className="px-4 py-2 bg-gradient-to-r from-blue-600 to-pink-500 text-white font-bold text-xs rounded-xl hover:opacity-95"
              >
                Simpan Sasaran
              </button>
            </div>
          </div>
        </div>
      )}

      {/* ==================== RESET CONFIRMATION MODAL ==================== */}
      {showResetModal && (
        <div className="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-white rounded-3xl max-w-sm w-full p-6 shadow-xl border border-slate-200 text-center space-y-4">
            <div className="w-12 h-12 bg-rose-100 text-rose-600 rounded-full flex items-center justify-center mx-auto">
              <RefreshCw className="w-6 h-6" />
            </div>
            <div>
              <h3 className="text-base font-bold text-slate-800">Adakah anda pasti?</h3>
              <p className="text-xs text-slate-500 mt-1">Semua rekod berat, checklist, mata dan refleksi akan dipadamkan sepenuhnya.</p>
            </div>
            <div className="flex space-x-2 pt-2">
              <button
                onClick={() => setShowResetModal(false)}
                className="w-1/2 py-2.5 bg-slate-100 text-slate-600 font-bold text-xs rounded-xl hover:bg-slate-200"
              >
                Batal
              </button>
              <button
                onClick={handleResetAllData}
                className="w-1/2 py-2.5 bg-rose-600 text-white font-bold text-xs rounded-xl hover:bg-rose-700"
              >
                Ya, Reset All
              </button>
            </div>
          </div>
        </div>
      )}

    </div>
  );
}
